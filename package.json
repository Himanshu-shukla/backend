{
  "name": "britinstitute-backend",
  "version": "1.0.0",
  "description": "Fastify + Mongoose backend for Brit Institute",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node src/seed.ts",
    "seed:coupons": "ts-node src/seedCoupons.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1060.0",
    "@fastify/cors": "^9.0.1",
