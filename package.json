    "fastify": "^4.28.1",
    "mongoose": "^8.4.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
